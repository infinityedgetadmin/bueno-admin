# Signs the session cookie. Use at least 32 random characters in production.
# When unset, a secret is generated once and kept in <data folder>/.session-secret.
ADMIN_SESSION_SECRET=

# Folder for catalog.json, team.json, credentials.json and audit.json. Defaults to ./data/store.
BUENO_DATA_DIR=

# Where the "View website" links point.
NEXT_PUBLIC_SITE_URL=https://bueno.example.com
